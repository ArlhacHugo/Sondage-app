<%- include('partials/head') %>

<h1>Administration</h1>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (success) { %><p class="success"><%= success %></p><% } %>

<% if (currentUser.is_superadmin) { %>
  <section class="admin-section">
    <h2>Ajouter un administrateur</h2>
    <p class="hint">
      Si l'email correspond à un compte existant, il devient administrateur.
      Sinon, un nouveau compte administrateur est créé avec le mot de passe indiqué.
    </p>
    <form method="POST" action="/admin/admins" class="form">
      <label>Email
        <input type="email" name="email" required>
      </label>
      <label>Mot de passe (8 caractères min., ignoré si le compte existe déjà)
        <input type="password" name="password" minlength="8">
      </label>
      <button type="submit">Ajouter comme administrateur</button>
    </form>
  </section>
<% } %>

<section class="admin-section">
  <h2>Comptes</h2>
  <table class="admin-table">
    <thead>
      <tr><th>Email</th><th>Rôle</th><th>Créé le</th><th></th></tr>
    </thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <tr>
          <td><%= u.email %></td>
          <td>
            <% if (u.is_superadmin) { %>Super-admin
            <% } else if (u.is_admin) { %>Admin
            <% } else { %>Utilisateur<% } %>
          </td>
          <td><%= u.created_at %></td>
          <td>
            <% if (u.id !== currentUser.id && (!u.is_superadmin || currentUser.is_superadmin)) { %>
              <form method="POST" action="/admin/users/<%= u.id %>/delete"
                    onsubmit="return confirm('Supprimer ce compte définitivement ?');">
                <button type="submit" class="danger">Supprimer</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>

<section class="admin-section">
  <h2>Sondages</h2>
  <table class="admin-table">
    <thead>
      <tr><th>Question</th><th>Auteur</th><th>Créé le</th><th></th></tr>
    </thead>
    <tbody>
      <% polls.forEach(function(p) { %>
        <tr>
          <td><a href="/polls/<%= p.id %>"><%= p.question %></a></td>
          <td><%= p.author %></td>
          <td><%= p.created_at %></td>
          <td>
            <form method="POST" action="/admin/polls/<%= p.id %>/delete"
                  onsubmit="return confirm('Supprimer ce sondage définitivement ?');">
              <button type="submit" class="danger">Supprimer</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>

<%- include('partials/foot') %>
