<%- include('partials/head') %>

<h1><%= poll.question %></h1>
<p class="poll-meta">
  Créé par <%= poll.author %>
  <% if (poll.restricted) { %> · <span class="badge-restricted">Sondage restreint</span><% } %>
</p>

<% if (!currentUser) { %>
  <p><a href="/login">Connecte-toi</a> pour répondre à ce sondage.</p>
<% } else if (poll.restricted && !allowedToVote) { %>
  <p class="error">Ce sondage est réservé à une liste de personnes précises, et ton compte n'en fait pas partie.</p>
<% } %>

<% if (currentUser && (!poll.restricted || allowedToVote)) { %>
  <form method="POST" action="/polls/<%= poll.id %>/vote" class="form">
    <% questions.forEach(function(q, qi) { %>
      <div class="question-block">
        <p class="question-block-title">Question <%= qi + 1 %> — <%= q.text %></p>
        <% if (q.userAnswered && !currentUser.is_admin) { %>
          <p class="hint">Tu as déjà répondu à cette question.</p>
        <% } else { %>
          <% if (q.userAnswered && currentUser.is_admin) { %>
            <p class="hint">En tant qu'administrateur, tu peux répondre à nouveau.</p>
          <% } %>
          <% q.options.forEach(function(opt) { %>
            <label class="option-radio">
              <input type="radio" name="answers[<%= q.id %>]" value="<%= opt.id %>">
              <%= opt.text %>
            </label>
          <% }); %>
        <% } %>
      </div>
    <% }); %>
    <button type="submit">Envoyer mes réponses</button>
  </form>
<% } %>

<% questions.forEach(function(q, qi) { %>
  <h2>Résultats — Question <%= qi + 1 %> (<%= q.totalVotes %> vote<%= q.totalVotes > 1 ? 's' : '' %>)</h2>
  <p class="poll-meta"><%= q.text %></p>
  <ul class="results">
    <% q.options.forEach(function(opt) { %>
      <% const pct = q.totalVotes > 0 ? Math.round((opt.votes / q.totalVotes) * 100) : 0; %>
      <li>
        <div class="result-label">
          <span><%= opt.text %></span>
          <span><%= opt.votes %> vote(s) — <%= pct %>%</span>
        </div>
        <div class="bar-bg">
          <div class="bar-fill" style="width: <%= pct %>%;"></div>
        </div>
      </li>
    <% }); %>
  </ul>
<% }); %>

<% if (respondents) { %>
  <section class="admin-section">
    <h2>Qui a répondu (<%= respondents.length %>)</h2>
    <% if (respondents.length === 0) { %>
      <p class="hint">Personne n'a encore répondu.</p>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr><th>Email</th><th>Questions répondues</th><th>Dernière réponse</th></tr>
        </thead>
        <tbody>
          <% respondents.forEach(function(r) { %>
            <tr>
              <td><%= r.email %></td>
              <td><%= r.answered_count %> / <%= questions.length %></td>
              <td><%= r.last_answer %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>

  <% if (notYetResponded) { %>
    <section class="admin-section">
      <h2>N'ont pas encore répondu (<%= notYetResponded.length %>)</h2>
      <% if (notYetResponded.length === 0) { %>
        <p class="hint">Tout le monde a répondu !</p>
      <% } else { %>
        <ul class="results">
          <% notYetResponded.forEach(function(w) { %>
            <li><%= w.email %></li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  <% } %>
<% } %>

<% if (currentUser && currentUser.is_admin) { %>
  <form method="POST" action="/admin/polls/<%= poll.id %>/delete"
        onsubmit="return confirm('Supprimer définitivement ce sondage ?');">
    <button type="submit" class="danger">Supprimer ce sondage (admin)</button>
  </form>
<% } %>

<%- include('partials/foot') %>
