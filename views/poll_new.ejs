<%- include('partials/head') %>

<h1>Créer un sondage</h1>

<% if (error) { %><p class="error"><%= error %></p><% } %>

<form method="POST" action="/polls" class="form" id="poll-form">
  <label>Titre du sondage
    <input type="text" name="question" required>
  </label>

  <div id="questions-wrapper"></div>

  <button type="button" id="add-question">+ Ajouter une question</button>

  <div class="restrict-block">
    <label class="checkbox-row">
      <input type="checkbox" name="restricted" id="restricted-check">
      Restreindre ce sondage à une liste de personnes précises
    </label>

    <div id="emails-wrapper" style="display: none;">
      <label>Emails autorisés à répondre (un par ligne, ou séparés par des virgules)
        <textarea name="emails" rows="5" placeholder="alice@exemple.com&#10;bob@exemple.com"></textarea>
      </label>
      <p class="hint">
        Seules les personnes ayant un compte avec l'un de ces emails pourront voter.
        Les autres visiteurs verront le sondage mais ne pourront pas répondre.
      </p>
    </div>
  </div>

  <button type="submit">Créer le sondage</button>
</form>

<script>
  let questionCount = 0;

  function addQuestionBlock() {
    const idx = questionCount;
    questionCount += 1;
    const wrapper = document.getElementById('questions-wrapper');

    const block = document.createElement('div');
    block.className = 'question-block';

    const heading = document.createElement('p');
    heading.className = 'question-block-title';
    heading.textContent = 'Question ' + (idx + 1);
    block.appendChild(heading);

    const qLabel = document.createElement('label');
    qLabel.textContent = 'Texte de la question';
    const qInput = document.createElement('input');
    qInput.type = 'text';
    qInput.name = 'questions[' + idx + '][text]';
    qInput.required = true;
    qLabel.appendChild(qInput);
    block.appendChild(qLabel);

    const optionsWrapper = document.createElement('div');
    optionsWrapper.className = 'options-wrapper';

    function addOption() {
      const optCount = optionsWrapper.querySelectorAll('input').length;
      const optLabel = document.createElement('label');
      optLabel.textContent = 'Option ' + (optCount + 1);
      const optInput = document.createElement('input');
      optInput.type = 'text';
      optInput.name = 'questions[' + idx + '][options][]';
      optLabel.appendChild(optInput);
      optionsWrapper.appendChild(optLabel);
    }

    addOption();
    addOption();
    block.appendChild(optionsWrapper);

    const addOptionBtn = document.createElement('button');
    addOptionBtn.type = 'button';
    addOptionBtn.textContent = '+ Ajouter une option';
    addOptionBtn.addEventListener('click', addOption);
    block.appendChild(addOptionBtn);

    wrapper.appendChild(block);
  }

  document.getElementById('add-question').addEventListener('click', addQuestionBlock);

  // On démarre avec une première question déjà prête à remplir
  addQuestionBlock();

  document.getElementById('restricted-check').addEventListener('change', function () {
    document.getElementById('emails-wrapper').style.display = this.checked ? 'block' : 'none';
  });
</script>

<%- include('partials/foot') %>
