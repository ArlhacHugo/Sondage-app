<%- include('partials/head') %>

<h1>Créer un sondage</h1>

<% if (error) { %><p class="error"><%= error %></p><% } %>

<form method="POST" action="/polls" class="form" id="poll-form">
  <label>Question
    <input type="text" name="question" required>
  </label>

  <div id="options-wrapper">
    <label>Option 1
      <input type="text" name="options" required>
    </label>
    <label>Option 2
      <input type="text" name="options" required>
    </label>
  </div>

  <button type="button" id="add-option">+ Ajouter une option</button>

  <div class="restrict-block">
    <label class="checkbox-row">
      <input type="checkbox" name="restricted" id="restricted-check">
      Restreindre ce sondage à une liste de personnes précises
    </label>

    <div id="emails-wrapper" style="display: none;">
      <label>Emails autorisés à répondre (un par ligne, ou séparés par des virgules)
        <textarea name="emails" rows="5" placeholder="alice@exemple.com&#10;bob@exemple.com"></textarea>
      </label>
      <p class="hint">
        Seules les personnes ayant un compte avec l'un de ces emails pourront voter.
        Les autres visiteurs verront le sondage mais ne pourront pas répondre.
      </p>
    </div>
  </div>

  <button type="submit">Créer le sondage</button>
</form>

<script>
  document.getElementById('add-option').addEventListener('click', function () {
    const wrapper = document.getElementById('options-wrapper');
    const count = wrapper.querySelectorAll('input[name="options"]').length + 1;
    const label = document.createElement('label');
    label.textContent = 'Option ' + count;
    const input = document.createElement('input');
    input.type = 'text';
    input.name = 'options';
    label.appendChild(input);
    wrapper.appendChild(label);
  });

  document.getElementById('restricted-check').addEventListener('change', function () {
    document.getElementById('emails-wrapper').style.display = this.checked ? 'block' : 'none';
  });
</script>

<%- include('partials/foot') %>
